<Window x:Class="Task5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task5"
        mc:Ignorable="d"
        Title="Shaded Cylinder" Width="1100" Height="760" MinWidth="900" MinHeight="620" Background="#F2F2F2">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Shaded Cylinder" FontSize="18" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <GroupBox Header="Camera controls" Padding="10">
                    <StackPanel>
                        <TextBlock x:Name="AngleXText" />
                        <Slider x:Name="AngleXSlider"
                                Minimum="-80"
                                Maximum="80"
                                Value="20"
                                TickFrequency="5"
                                Margin="0,3,0,12"
                                ValueChanged="ControlChanged" />

                        <TextBlock x:Name="AngleYText" />
                        <Slider x:Name="AngleYSlider"
                                Minimum="-180"
                                Maximum="180"
                                Value="-25"
                                TickFrequency="5"
                                Margin="0,3,0,12"
                                ValueChanged="ControlChanged" />

                        <TextBlock x:Name="DistanceText" />
                        <Slider x:Name="DistanceSlider"
                                Minimum="3.0"
                                Maximum="9.0"
                                Value="5.2"
                                TickFrequency="0.2"
                                Margin="0,3,0,12"
                                ValueChanged="ControlChanged" />

                        <TextBlock x:Name="SegmentsText" />
                        <Slider x:Name="SegmentsSlider"
                                Minimum="8"
                                Maximum="96"
                                Value="48"
                                TickFrequency="4"
                                IsSnapToTickEnabled="True"
                                Margin="0,3,0,14"
                                ValueChanged="SegmentsChanged" />

                        <Button Content="Reset camera" Height="30" Click="ResetCamera_Click" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Scene data" Padding="10" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Cylinder radius: 1.0" />
                        <TextBlock Text="Cylinder height: 2.5" Margin="0,4,0,0" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#111111"
                    BorderBrush="#C8C8C8"
                    BorderThickness="1"
                    Padding="4">
                <Image x:Name="RenderImage" Stretch="Uniform" />
            </Border>
        </Grid>
    </Grid>
</Window>
